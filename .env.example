# =============================================================================
# Codenyr Prospection — modèle de configuration
# -----------------------------------------------------------------------------
# Copier ce fichier en .env puis le remplir. Le fichier .env n'est JAMAIS
# commité (il est dans .gitignore). Aucune vraie valeur ne doit figurer ici.
# =============================================================================

# --- Application --------------------------------------------------------------
APP_NAME="Codenyr Prospection"
# local en développement, production sur le VPS
APP_ENV=local
# Générée par « php artisan key:generate ». Sert aussi à chiffrer le secret 2FA :
# ne jamais la changer en production sans procédure (la 2FA deviendrait illisible).
APP_KEY=
# true en local uniquement ; TOUJOURS false en production
APP_DEBUG=true
# URL d'accès à l'outil (Herd : http://codenyr-prospection.test)
APP_URL=http://codenyr-prospection.test

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Double authentification (TOTP) ------------------------------------------
# true = 2FA obligatoire à la connexion (recommandé). false la coupe en local
# seulement : en production (APP_ENV=production) elle reste toujours imposée.
AUTH_TWO_FACTOR_REQUIRED=true

# --- Journaux -----------------------------------------------------------------
# Les journaux restent dans storage/logs, jamais exposés sur le web.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# debug en local, warning en production
LOG_LEVEL=debug

# --- Base de données (MySQL ou PostgreSQL, cf. cahier des charges) -----------
# Pour PostgreSQL : DB_CONNECTION=pgsql et DB_PORT=5432.
# Pour un essai rapide sans serveur : DB_CONNECTION=sqlite et commenter le reste.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=codenyr_prospection
DB_USERNAME=
DB_PASSWORD=

# --- Sessions -----------------------------------------------------------------
SESSION_DRIVER=database
# Durée d'inactivité avant déconnexion, en minutes
SESSION_LIFETIME=120
# Contenu des sessions chiffré (l'outil contient des données personnelles)
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true en production (cookie envoyé uniquement en HTTPS)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Files d'attente (Redis + Horizon) ---------------------------------------
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# --- Redis --------------------------------------------------------------------
# phpredis (extension PHP) ; utiliser « predis » si l'extension est absente.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# Laisser null en local sans mot de passe ; en production, définir un mot de passe.
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Horizon ------------------------------------------------------------------
# Tableau de bord des files, accessible uniquement connecté avec 2FA.
HORIZON_PATH=horizon
# HORIZON_PREFIX=codenyr_prospection_horizon:

# --- Sources de données (M4) : gratuites, sans clé ---------------------------
# Les adresses par défaut sont dans config/prospection.php ; ne les changer qu'en cas de besoin.
# User-Agent envoyé aux API et aux sites visités (identifie honnêtement l'outil).
PROSPECTION_USER_AGENT="CodenyrProspection/1.0 (+https://codenyr.fr)"
# Pages de 25 résultats parcourues au maximum par lancement de recherche (40 = 1 000 entreprises).
RECHERCHE_ENTREPRISES_MAX_PAGES=40
# Enrichissements par minute (OpenStreetMap + devinette de domaine) : usage raisonnable.
PROSPECTION_ENRICHMENTS_PER_MINUTE=20
# RECHERCHE_ENTREPRISES_URL=https://recherche-entreprises.api.gouv.fr
# BODACC_URL=https://bodacc-datadila.opendatasoft.com/api/explore/v2.1/catalog/datasets/annonces-commerciales/records
# --- Analyse des sites (M5) --------------------------------------------------
# Sites analysés par minute (une visite de la page d'accueil, robots.txt respecté).
PROSPECTION_ANALYSES_PER_MINUTE=20
# Google PageSpeed Insights (score mobile). Sans clé, le quota partagé est presque toujours
# épuisé : créez une clé GRATUITE (Google Cloud > API PageSpeed Insights) et collez-la ici.
PAGESPEED_ENABLED=true
PAGESPEED_API_KEY=

# Serveur OpenStreetMap (Overpass) et délai d'attente de sa réponse, en secondes.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OVERPASS_TIMEOUT=60

# --- Recherche d'emails (M7) ----------------------------------------------------
# Accueil, page contact et mentions légales de chaque site (robots.txt respecté).
# Secondes d'attente entre deux pages d'un même site, et sites explorés par minute.
PROSPECTION_EMAIL_SEARCH_DELAY=2
PROSPECTION_EMAIL_SEARCHES_PER_MINUTE=10

# --- Emails -------------------------------------------------------------------
# « log » tant que l'envoi réel n'est pas mis en place (mission M9).
# L'envoi réel se fera depuis le domaine DÉDIÉ à la prospection, jamais
# depuis codenyr.fr ni une boîte Gmail personnelle.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="prenom@domaine-envoi-dedie.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Identité de l'expéditeur (M8) : pied de page légal de chaque email -------
# Obligatoires avant tout envoi : nom, adresse et SIRET (l'aperçu signale ce qui manque).
SENDER_NAME=
SENDER_COMPANY=Codenyr
SENDER_ADDRESS=
SENDER_SIRET=
SENDER_PHONE=
SENDER_WEBSITE=https://codenyr.fr
SENDER_PRIVACY_URL=https://codenyr.fr/confidentialite
# Lien du bouton (paramètres UTM ajoutés automatiquement).
EMAIL_CTA_URL=https://codenyr.fr
# Plafond quotidien GLOBAL d'envois (préchauffage : ~10/jour au début, à monter sur 3-4 semaines).
SENDING_DAILY_CAP=10
# Tes propres adresses pour « Envoyer un test » (Gmail, Outlook…), séparées par des virgules.
EMAIL_TEST_RECIPIENTS=

VITE_APP_NAME="${APP_NAME}"
